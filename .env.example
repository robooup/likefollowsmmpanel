# ---------------------------------------------------------------------------
# TopupCraft — environment (copy to .env). deploy/setup-server.sh writes this
# file for you with random secrets.
# ---------------------------------------------------------------------------

# The site's own domain. Panels get free subdomains under it.
PLATFORM_ROOT_DOMAIN="topupcraft.com"
# Hosts that serve the TopupCraft site (default: root domain + www).
# PLATFORM_HOSTS="topupcraft.com,www.topupcraft.com"

# Public IP of this server, shown to customers in DNS instructions.
SERVER_IP=""

# Control-plane database (customers, plans, panels, domains, invoices).
PLATFORM_DATABASE_URL="postgresql://tc:PASSWORD@127.0.0.1:5432/tc_platform"
# Panel databases. {db} is replaced with each panel's database name.
TENANT_DATABASE_URL="postgresql://tc:PASSWORD@127.0.0.1:5432/{db}"
# New panels are cloned from this database.
TENANT_TEMPLATE_DB="tc_panel_template"
# Only used by the Prisma CLI (schema push / seed). Point it at the template.
DATABASE_URL="postgresql://tc:PASSWORD@127.0.0.1:5432/tc_panel_template"

# Secrets — long random strings, different from each other. Never share them.
PLATFORM_SECRET=""      # signs TopupCraft logins
NEXTAUTH_SECRET=""      # signs panel logins
CRON_SECRET=""          # lets the local scheduler call maintenance

# Where uploaded panel files are stored (one folder per panel).
STORAGE_DIR="/var/lib/topupcraft/storage"

PORT="3000"
# Connections per panel database, and how many panel databases stay connected.
# TENANT_DB_POOL_SIZE="3"
# TENANT_MAX_CLIENTS="40"

# Blocks outbound requests to private/internal addresses. On by default in
# production; do not turn off on a live server.
# SSRF_GUARD="on"
